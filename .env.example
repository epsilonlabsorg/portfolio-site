# Public inbox displayed on the website. Confirm this address before launch.
VITE_CONTACT_EMAIL=info.epsilondev@gmail.com

# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
# Leave blank until you have deployed the included migration and Edge Function.
# No browser API key is needed for this public contact-only endpoint.
VITE_SUPABASE_URL=

# Optional alternative handler. Overrides VITE_SUPABASE_URL. Never put secrets here.
# Leave empty to let visitors prepare, review, and send an email draft.
VITE_CONTACT_ENDPOINT=
