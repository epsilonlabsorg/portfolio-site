# Exact website origins, comma separated. Replace with your domain for production.
CONTACT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Replace with a random secret of at least 32 characters before running/deploying.
# Generate locally with: openssl rand -hex 32
CONTACT_RATE_LIMIT_SALT=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# Never copy service-role keys or this salt into VITE_ variables.
